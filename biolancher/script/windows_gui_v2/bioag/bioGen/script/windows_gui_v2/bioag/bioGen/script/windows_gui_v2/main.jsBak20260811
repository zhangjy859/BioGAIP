async function waitForUserModeSelection() {
  logDebug('--- ENTERING MODE SELECTION WAIT STATE ---');
  return new Promise(resolve => {
    ipcMain.once('mode-selected', (event, mode) => {
      logDebug(`Received mode-selected event: ${mode}`);
      resolve(mode);
    });
    if (mainWindow && !mainWindow.isDestroyed()) {
      logDebug('Instructing Renderer to display Mode Selection');
      mainWindow.webContents.executeJavaScript(`window.showModeSelection()`).catch(e => logDebug(`Failed to call showModeSelection: ${e.message}`));
    }
  });
}

async function createWindow() {
  mainWindow = new BrowserWindow({
    width: 1200,
    height: 800,
    show: true,
    backgroundColor: '#f2f3f5',
    webPreferences: {
      nodeIntegration: true,
      contextIsolation: false,
      webSecurity: false,
      allowRunningInsecureContent: true
    }
  });

  logDebug('Writing HTML payload to physical temp file to bypass strict CSP');
  const tempHtmlPath = path.join(app.getPath('temp'), 'biogen_splash.html');
  fs.writeFileSync(tempHtmlPath, LOADING_HTML);

  await mainWindow.loadFile(tempHtmlPath);

  app.on('certificate-error', (event, webContents, url, error, certificate, callback) => {
    event.preventDefault();
    callback(true);
  });

  let pythonPath;
  try {
    pythonPath = findPython();
  } catch (err) {
    logDebug('Failed to locate Python environment');
    dialog.showMessageBoxSync({ type: 'error', title: 'Environment Error', message: 'Python environment not found.' });
    app.quit();
    return;
  }

  updateUI('Checking Environment', 'Verifying required dependencies...', 'Scanning local Python environment.');

  const hasStreamlit = await checkPackageInstalled(pythonPath, 'streamlit');
  if (!hasStreamlit) {
    logDebug('Streamlit not found. Entering core installation mode.');
    updateUI(
      'Initial Setup', 
      'Installing core dependencies...', 
      'This process only runs during the first launch.\nPlease be patient as it may take a few minutes.'
    );
    const reqPath = app.isPackaged
      ? path.join(process.resourcesPath, 'requirements.txt')
      : path.join(__dirname, 'requirements.txt');

    if (fs.existsSync(reqPath)) {
      // 5 min max timeout for pip install
      await runCommand(pythonPath, ['-m', 'pip', 'install', '-r', reqPath], { timeout: 300000 }, appendUILog);
    } else {
      logDebug(`requirements.txt not found at: ${reqPath}`);
    }
  } else {
    logDebug('Streamlit check passed.');
  }

  const hasBiogaip = await checkBiogaipInstalled(pythonPath);
  if (!hasBiogaip) {
    logDebug('BioGAIP easymode not found. Starting countdown for installation.');
    
    let userCancelled = false;
    const cancelHandler = () => {
      logDebug('User clicked UI cancel button. Aborting BioGAIP easymode install.');
      userCancelled = true;
    };
    ipcMain.once('cancel-biogaip-install', cancelHandler);

    for (let i = 3; i > 0; i--) {
      if (userCancelled) break;
      updateUI(
        'Environment Setup',
        'Preparing to install BioGAIP easymode...',
        `Installation will start automatically in ${i} seconds.`,
        true
      );
      await new Promise(r => setTimeout(r, 1000));
    }

    ipcMain.removeListener('cancel-biogaip-install', cancelHandler);

    if (!userCancelled) {
      logDebug('Countdown finished without cancellation. Starting pip install for pip_package.');
      updateUI(
        'Configuring Modules', 
        'Installing BioGAIP easymode...', 
        'This is a one-time setup. Please wait while packages are configured.',
        false
      );
      const pkgPath = app.isPackaged
        ? path.join(process.resourcesPath, 'src', 'pip_package')
        : path.join(__dirname, 'src', 'pip_package');

      if (fs.existsSync(pkgPath)) {
        const installRes = await runCommand(pythonPath, ['-m', 'pip', 'install', pkgPath], { timeout: 300000 }, appendUILog);
        if (installRes.code !== 0) {
          logDebug(`BioGAIP installation failed. stderr: ${installRes.stderr}`);
          showUIWarning('Installation failed. The app will launch, but BioGAIP easymode will be unavailable.');
          await new Promise(r => setTimeout(r, 3500)); 
        } else {
          logDebug('BioGAIP easymode installed successfully.');
        }
      } else {
        logDebug(`Package path not found: ${pkgPath}`);
      }
    } else {
      updateUI('Installation Skipped', 'BioGAIP easymode setup cancelled by user.', '', false);
      showUIWarning('Note: BioGAIP easymode will remain unavailable.');
      await new Promise(r => setTimeout(r, 2500));
    }
  } else {
    logDebug('BioGAIP easymode check passed.');
  }

  logDebug('All dependency checks complete.');

  // ==========================================
  // MODE SELECTION LOGIC
  // ==========================================
  let selectedMode = 'advanced'; 
  if (SHOW_MODE_SELECTION) {
    logDebug('Prompting user for operating mode selection.');
    selectedMode = await waitForUserModeSelection();
    logDebug(`User successfully selected mode: ${selectedMode}`);
  } else {
    logDebug('SHOW_MODE_SELECTION is false. Defaulting to advanced mode.');
    updateUI('Starting Service', 'Launching application server...', 'Almost there...', false);
  }

  const appPyPath = app.isPackaged
    ? path.join(process.resourcesPath, 'app.py')
    : path.join(__dirname, 'app.py');

  let launchArgs = [];
  if (selectedMode === 'easy') {
    logDebug('Preparing backend parameters for [EASY] mode.');
    launchArgs = [
      '-m', 'streamlit', 'run', appPyPath,
      '--server.port', PORT.toString(),
      '--server.address', '127.0.0.1',
      '--server.headless', 'true',
      '--browser.gatherUsageStats', 'false',
      '--server.enableCORS', 'false',
      '--server.enableXsrfProtection', 'false'
    ];
  } else {
    logDebug('Preparing backend parameters for [ADVANCED] mode.');
    launchArgs = [
      '-m', 'streamlit', 'run', appPyPath,
      '--server.port', PORT.toString(),
      '--server.address', '127.0.0.1',
      '--server.headless', 'true',
      '--browser.gatherUsageStats', 'false',
      '--server.enableCORS', 'false',
      '--server.enableXsrfProtection', 'false'
    ];
  }
  
  logDebug(`Spawning Streamlit with args: ${launchArgs.join(' ')}`);
  
  streamlitProcess = spawn(pythonPath, launchArgs, {
    stdio: ['pipe', 'pipe', 'pipe'],
    env: { ...process.env, PYTHONUNBUFFERED: '1', APP_MODE: selectedMode }
  });

  let loaded = false;

  const tryLoad = () => {
    if (loaded || !mainWindow) return;
    loaded = true;
    logDebug(`Server detected as ready. Redirecting UI to http://127.0.0.1:${PORT}`);
    if (checkInterval) clearInterval(checkInterval);
    
    // Clean up temp file
    try { if(fs.existsSync(tempHtmlPath)) fs.unlinkSync(tempHtmlPath); } catch(e){}

    mainWindow.loadURL(`http://127.0.0.1:${PORT}`).catch(err => {
      logDebug(`loadURL failed: ${err}`);
    });
  };

  const checkInterval = setInterval(async () => {
    if (await checkPortReady(PORT)) {
      logDebug(`Port ${PORT} connection check passed.`);
      tryLoad();
    }
  }, 500);

  streamlitProcess.stdout.on('data', (data) => {
    const output = data.toString();
    if (output.includes('You can now view your Streamlit app') ||
        output.includes('Uvicorn server started') ||
        output.includes('Local URL')) {
      logDebug('Streamlit stdout indicated ready state.');
      tryLoad();
    }
  });

  streamlitProcess.stderr.on('data', (data) => {
    logDebug(`[Streamlit STDERR] ${data.toString().trim()}`);
  });

  streamlitProcess.on('error', (err) => {
    logDebug(`Streamlit spawn error: ${err.message}`);
    if (checkInterval) clearInterval(checkInterval);
    dialog.showErrorBox('Startup Failed', err.message);
  });

  streamlitProcess.on('exit', (code, signal) => {
    logDebug(`Streamlit process exited. Code: ${code}, Signal: ${signal}`);
  });

  setTimeout(() => {
    if (!loaded) {
      logDebug('20-second backend timeout reached. Forcing UI redirect just in case.');
      tryLoad();
    }
  }, 20000);

  mainWindow.on('closed', () => {
    logDebug('Main window closed by user.');
    if (checkInterval) clearInterval(checkInterval);
    mainWindow = null;
    if (streamlitProcess) {
      streamlitProcess.kill();
      streamlitProcess = null;
    }
  });
}

app.on('ready', async () => {
  logDebug(`App ready event fired. Checking if port ${PORT} is occupied.`);
  const portOccupied = await isPortInUse(PORT);
  if (portOccupied) {
    logDebug(`Port ${PORT} is currently in use. Blocking startup.`);
    dialog.showMessageBoxSync({
      type: 'warning',
      title: 'Port Occupied',
      message: `Port ${PORT} is already in use.`,
      buttons: ['OK']
    });
    app.quit();
    return;
  }
  logDebug(`Port ${PORT} is free. Proceeding to create window.`);
  createWindow();
});

app.on('window-all-closed', () => {
  logDebug('All windows closed. Quitting app (except Darwin).');
  if (process.platform !== 'darwin') app.quit();
});

app.on('activate', () => {
  if (mainWindow === null) {
    logDebug('App activated (macOS). Recreating window.');
    createWindow();
  }
});

app.on('before-quit', () => {
  logDebug('App before-quit event. Killing child process if exists.');
  if (streamlitProcess) {
    streamlitProcess.kill('SIGTERM');
    streamlitProcess = null;
  }
});