# Process pending user messages
if "messages" in st.session_state and st.session_state.messages:
    # Process the latest unprocessed user message
    last_user_message = next((msg for msg in reversed(st.session_state.messages) if msg["role"] == "user" and not msg.get("processed")), None)
    if last_user_message:
        if not chat_init:
            user_message = last_user_message["content"]
            last_user_message["processed"] = True  # Mark as processed

            placeholder = st.empty()
            placeholder.markdown("Processing...")

            team = st.session_state.team
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
            async_gen = team.run_stream(
                task=[TextMessage(content=user_message, source="user")],
                cancellation_token=CancellationToken(),
            )

            current_source = None
            current_placeholder = None
            current_content = ""
            chat_init = True
        else:
            user_message = last_user_message["content"]
            last_user_message["processed"] = True
            placeholder = st.empty()
            placeholder.markdown("Processing...")
            team = st.session_state.team
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
            async_gen = team.run_stream(
                task=[TextMessage(content=user_message, source="user")],
                cancellation_token=CancellationToken(),
            )

        while True:
            try:
                msg = loop.run_until_complete(anext(async_gen))
                if msg is not None and not isinstance(msg, TaskResult):
                    if isinstance(msg, ModelClientStreamingChunkEvent) or isinstance(msg, TextMessage) or isinstance(msg, GroupChatMessage):
                        if msg.source != current_source:
                            if current_placeholder is not None:
                                st.session_state.messages.append({"role": current_source, "content": current_content})
                            current_source = msg.source
                            with st.chat_message(current_source, avatar=get_avatar(current_source)):
                                current_placeholder = st.empty()
                                current_content = ""
                        if isinstance(msg, ModelClientStreamingChunkEvent):
                            current_content += msg.content
                        elif isinstance(msg, TextMessage) or isinstance(msg, GroupChatMessage):
                            current_content += msg.content + "\n"
                        current_placeholder.markdown(current_content)
                    elif isinstance(msg, ToolCallExecutionEvent) or isinstance(msg, ToolCallRequestEvent):
                        if current_placeholder is None:
                            current_source = "system"
                            with st.chat_message(current_source, avatar=get_avatar(current_source)):
                                current_placeholder = st.empty()
                                current_content = ""
                        try:
                            cmd = msg.content[0].content
                        except:
                            cmd = msg.content[0].arguments
                        current_content += f"```\n{cmd}\n```\n"
                        current_placeholder.markdown(current_content)
                        st.toast(
                            f"Start executing command\nView progression at {os.environ.get('API_URL')} with your API key",
                            icon="ℹ️")
                        st.toast("This page will auto refresh after command execution is complete.", icon="ℹ️")
            except StopAsyncIteration:
                break

        if isinstance(msg, TaskResult):
            termination_msg = "Task terminated. "
            if msg.stop_reason:
                termination_msg += msg.stop_reason
            with st.chat_message("system", avatar=get_avatar("system")):
                st.markdown(termination_msg)
            st.session_state.messages.append({"role": "system", "content": termination_msg})

        if current_placeholder is not None:
            st.session_state.messages.append({"role": current_source, "content": current_content})

        placeholder.empty()