# Sync version of user_input_func, using Streamlit's rerun model to "wait" for input
def user_input_func(prompt: str) -> str:
    st.info(prompt)
    # Use a dynamic key to allow multiple inputs in the same session
    key = f"input_{st.session_state.input_counter}"
    response = st.text_input("Provide your input:", key=key)
    if response:
        st.session_state.input_counter += 1  # Increment counter for next input
        return response
    st.stop()  # Stop script execution until input is provided
    return ""

# Sync version of user_action_func
def user_action_func(prompt: str) -> str:
    st.info(prompt)
    col1, col2 = st.columns(2)
    with col1:
        if st.button("Approve"):
            return "APPROVE."
    with col2:
        if st.button("Reject"):
            return "REJECT."
    st.stop()  # Stop until button pressed
    return "User did not provide any input."

